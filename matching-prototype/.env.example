# Copy this file to .env and fill in the real key. .env is gitignored --
# never commit it.
OPENAI_API_KEY=sk-your-key-here

# Cheapest OpenAI models as of Nov 2026. If gpt-5-nano is retired or
# behaves oddly, switch to gpt-4.1-nano or gpt-4o-mini -- nothing else
# needs to change.
MATCHING_EMBEDDING_MODEL=text-embedding-3-small
MATCHING_RERANK_MODEL=gpt-5-nano
MATCHING_LLM_RERANK=true

# Ranking knobs -- see matching-prototype/README.md
MATCHING_MIN_SIMILARITY=0.15
MATCHING_TOP_K=10
MATCHING_WEIGHT_SIMILARITY=0.7
MATCHING_WEIGHT_TRUST=0.15
MATCHING_WEIGHT_RECENCY=0.1
MATCHING_WEIGHT_VOUCH=0.05
MATCHING_RECENCY_HALF_LIFE_DAYS=180
