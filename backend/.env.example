# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# AWS RDS Postgres connection string (existing instance).
# Format: postgresql://<user>:<password>@<rds-endpoint>:5432/<database>?sslmode=require
DATABASE_URL="postgresql://user:password@your-rds-endpoint.rds.amazonaws.com:5432/searchincircle?sslmode=require"

PORT=3000
